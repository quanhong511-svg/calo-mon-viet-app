{
  "expo": {
    "name": "Calo Món Việt",
    "slug": "calo-mon-viet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calomonvietapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tranhongquan.calomonviet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f6b4f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tranhongquan.calomonviet"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f6b4f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Calo Món Việt dùng camera để chụp món ăn và tính calo.",
          "photosPermission": "Calo Món Việt cần chọn ảnh món ăn trong thư viện để tính calo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0f6b4f"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "686601ab-4c35-48dc-9684-4c858f036a73"
      }
    },
    "owner": "quanhong511"
  }
}
